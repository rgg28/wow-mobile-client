<Project Sdk="Godot.NET.Sdk/4.2.1">
  <PropertyGroup>
    <!-- CORREGIDO: Sincronizado a .NET 8 con soporte móvil optimizado -->
    <TargetFramework>net8.0</TargetFramework>
    
    <!-- ELIMINADO: EnableDynamicLoading (Evita cierres por políticas de seguridad en Android) -->
    
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <!-- OPTIMIZACIÓN: Indica al compilador que prepare el entorno para Android si se ejecuta la build -->
    <TargetPlatform Condition=" '$(Platform)' == 'Android' ">android</TargetPlatform>
  </PropertyGroup>
</Project>
