<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com"
    package="com.wow.client">

    <!-- Permiso esencial para conectar al servidor de WoW -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="WoW 3.3.5a Android"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        
        <!-- Configuración de la actividad principal en pantalla completa horizontal -->
        <activity
            android:name="com.wow.client.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            
        </activity>
    </application>

</manifest>

